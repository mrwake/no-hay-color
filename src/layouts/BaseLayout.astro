---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1ede4" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} — No hay color</title>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('theme');
        const systemTheme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = savedTheme || systemTheme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="No hay color, inicio">NO HAY COLOR</a>
      <div class="header-actions">
        <span class="header-note">Entrevistas y retratos sin filtros</span>
        <div class="theme-selector" role="group" aria-label="Seleccionar tema">
          <button class="theme-option" type="button" data-theme-choice="light" aria-pressed="false">Claro</button>
          <button class="theme-option" type="button" data-theme-choice="dark" aria-pressed="false">Oscuro</button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href={base}>NO HAY COLOR</a>
      <span>Hecho con calma, texto a texto.</span>
    </footer>
    <script>
      const root = document.documentElement;
      const themeOptions = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      const updateThemeControls = () => {
        const isLight = root.dataset.theme === 'light';
        themeColor?.setAttribute('content', isLight ? '#f1ede4' : '#1d1c19');
        themeOptions.forEach((option) => {
          option.setAttribute(
            'aria-pressed',
            String(option.dataset.themeChoice === root.dataset.theme),
          );
        });
      };

      updateThemeControls();

      themeOptions.forEach((option) => {
        option.addEventListener('click', () => {
          const nextTheme = option.dataset.themeChoice;
          if (nextTheme !== 'light' && nextTheme !== 'dark') return;
          root.dataset.theme = nextTheme;
          localStorage.setItem('theme', nextTheme);
          updateThemeControls();
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f1ede4;
    --panel: #e8e2d6;
    --ink: #292721;
    --body-text: #504d45;
    --muted: #777166;
    --line: #d1c9bb;
    --accent: #8c7657;
    --glow: rgb(163 143 111 / 16%);
    --glow-secondary: rgb(126 120 105 / 8%);
    font-family: Georgia, "Times New Roman", serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --paper: #1d1c19;
    --panel: #282620;
    --ink: #f0ece4;
    --body-text: #d0cbc1;
    --muted: #aaa397;
    --line: #403c34;
    --accent: #c5ad89;
    --glow: rgb(133 120 99 / 18%);
    --glow-secondary: rgb(95 91 81 / 11%);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background:
      radial-gradient(ellipse 72% 34% at 50% 0%, var(--glow), transparent 100%),
      radial-gradient(ellipse 52% 32% at 100% 45%, var(--glow-secondary), transparent 100%),
      var(--paper);
    background-attachment: fixed;
    color: var(--ink);
    transition: background-color 180ms ease, color 180ms ease;
  }

  body {
    margin: 0 auto;
    max-width: 1440px;
    padding: 0 clamp(1.25rem, 5vw, 5rem);
  }

  a {
    color: inherit;
  }

  button {
    font: inherit;
  }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 1.25rem 0;
  }

  .wordmark,
  .site-footer a {
    font-family: Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-decoration: none;
  }

  .header-note,
  .site-footer span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .header-actions {
    align-items: center;
    display: flex;
    gap: 1.25rem;
  }

  .theme-selector {
    align-items: center;
    background: color-mix(in srgb, var(--paper) 88%, var(--ink));
    border: 1px solid var(--line);
    border-radius: 999px;
    display: inline-flex;
    padding: 0.18rem;
  }

  .theme-option {
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font-family: Arial, sans-serif;
    font-size: 0.68rem;
    line-height: 1;
    padding: 0.48rem 0.58rem;
  }

  .theme-option[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .theme-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  main {
    min-height: 70vh;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    border-bottom: 0;
    margin-top: 6rem;
  }

  @media (max-width: 560px) {
    .header-note {
      display: none;
    }

    .header-actions {
      gap: 0;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
